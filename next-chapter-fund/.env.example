# ─────────────────────────────────────────────────────────────
# The Next Chapter Fund — environment variables
# Copy this file to .env.local for local development.
# On Vercel, add these under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Donation platform URL (Givebutter campaign page, or another provider).
# Every "Donate" button on the site links here.
# Example: https://givebutter.com/your-campaign-slug
NEXT_PUBLIC_DONATION_URL=

# Canonical site URL, used for SEO metadata, Open Graph tags, and the sitemap.
# Example: https://thenextchapterfund.org
NEXT_PUBLIC_SITE_URL=

# Optional: form provider endpoint (Formspree, HubSpot, Mailchimp, etc.).
# Leave empty to keep forms in front-end demo mode (validation + success
# states work, nothing is sent anywhere). See src/lib/forms.ts.
# Example (Formspree): https://formspree.io/f/your-form-id
NEXT_PUBLIC_FORM_ENDPOINT=
